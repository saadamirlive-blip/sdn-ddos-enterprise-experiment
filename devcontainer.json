{
  "name": "SDN Security Lab & Mininet Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "runArgs": [
    "--privileged",
    "--cap-add=NET_ADMIN",
    "--cap-add=SYS_ADMIN"
  ],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "vscode"
}
